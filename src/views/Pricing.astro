---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Crumbs from '../components/Crumbs.astro'
import { url, SITE_URL } from '../lib/site'
import { data, lp, type Lang } from '../i18n'
interface Props { lang: Lang }
const { lang } = Astro.props
const { packages, faq, pricingNote, remote, addonCM } = data(lang)
const L = (p: string) => url(lp(lang, p))
const C = {
  en: { title: 'Plans and Pricing: a Team from $600 | Federico Schwindt', desc: 'Launch $600 + $80/month (2 requests at a time), Grow $1,200 + $150/month (4), Scale $3,000 + $250/month (6). Community management +$1,000/month.',
    crumb: 'Pricing', h1: ['Plans, not', 'projects.'], lead: 'A one-time build, then a monthly plan: hosting, security and a whole team working through your requests, several at a time.', setup: 'setup', choose: 'Choose', chooseA: (n: string) => `Choose the ${n} plan`, plan: (n: string) => `${n} website plan`,
    remote: ['Working', 'at a distance.'], asked: ['Asked', 'often.'], ready: ['Ready when', 'you are.'], start: 'Start a project', see: 'See the services' },
  es: { title: 'Planes y precios: un equipo desde $600 | Federico Schwindt', desc: 'Launch $600 + $80/mes (2 pedidos a la vez), Grow $1,200 + $150/mes (4), Scale $3,000 + $250/mes (6). Community management +$1,000/mes.',
    crumb: 'Precios', h1: ['Planes, no', 'proyectos.'], lead: 'Un desarrollo inicial y después un plan mensual: hosting, seguridad y un equipo entero trabajando tus pedidos, varios a la vez.', setup: 'inicial', choose: 'Elegir', chooseA: (n: string) => `Elegir el plan ${n}`, plan: (n: string) => `Plan web ${n}`,
    remote: ['Trabajar', 'a distancia.'], asked: ['Preguntas', 'frecuentes.'], ready: ['Cuando', 'tú quieras.'], start: 'Empezar un proyecto', see: 'Ver los servicios' },
}[lang]
import AppShow from '../components/AppShow.astro'
import Compare from '../components/Compare.astro'
import Next from '../components/Next.astro'
import { blocks } from '../data/blocks'
import '../styles/home.css'
import '../styles/home-app.css'
import '../styles/pages.css'

const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
const offersLd = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Federico Schwindt', url: `${SITE_URL}${lp(lang, '/')}`,
  makesOffer: packages.map((p) => ({ '@type': 'Offer', name: C.plan(p.name), price: p.price.replace(/[$,]/g, ''), priceCurrency: 'USD', description: p.text })),
}
---
<Base title={C.title} description={C.desc} ld={[faqLd, offersLd]} lang={lang}>
  <header class="phead t-paper">
    <div class="wrap">
      <Crumbs trail={[{ label: C.crumb }]} lang={lang} />
      <h1 class="d h-xl" data-lines><span class="line"><span>{C.h1[0]}</span></span><span class="line" style="--i:1"><span><i>{C.h1[1]}</i></span></span></h1>
      <p class="lead pr-lead" data-reveal>{C.lead}</p>
    </div>
  </header>
  <section class="t-paper pc pr-plans">
    <div class="wrap">
      <div class="pc__rows" data-fx="gap">
        {packages.map((p, i) => (
          <article class={`tk ${i === 1 ? 'tk--hot' : ''}`} data-reveal style={`--i:${i}`}>
            <div class="tk__main">
              <h2 class="d tk__name">{p.name}</h2>
              <p class="tk__text">{p.text}</p>
              <ul>{p.items.map((it) => <li><Icon name="check" />{it}</li>)}</ul>
            </div>
            <div class="tk__stub">
              <p class="tk__price"><b class="d n">{p.price}</b><span class="mono">{C.setup} + {p.monthly}</span></p>
              <p class="pk__req mono"><i aria-hidden="true"></i>{p.requests}</p>
              <a class="btn" href={url(lp(lang, `/checkout/?plan=${p.name.toLowerCase()}`))} aria-label={C.chooseA(p.name)}>{C.choose} {p.name} <Icon name="arrowUpRight" /></a>
            </div>
          </article>
        ))}
      </div>
      <p class="pr-note" data-reveal><b>{pricingNote.lead}</b> {pricingNote.text}</p>
      <p class="pr-note pk__cm" data-reveal><b>+ {addonCM.t}</b> {addonCM.price}. {addonCM.d}</p>
      <p class="pr-quiz" data-reveal><button type="button" class="btn" data-plans data-plans-quiz>{lang === 'es' ? '¿Cuál me conviene? Tres preguntas' : 'Which one fits me? Three questions'} <Icon name="arrowRight" /></button></p>
    </div>
  </section>
  <section class="section t-ink app" data-app>
    <AppShow lang={lang} />
  </section>
  <section class="section t-paper cmp">
    <Compare lang={lang} cta={lang === 'es' ? 'Elegir un plan' : 'Choose a plan'} />
  </section>
  <section class="section t-ink">
    <div class="wrap">
      <h2 class="d h-l" data-lines><span class="line"><span>{C.remote[0]} <i>{C.remote[1]}</i></span></span></h2>
      <dl class="pr-remote">
        {remote.map((r, i) => <div data-reveal style={`--i:${i}`}><dt class="d h-s">{r.t}</dt><dd class="muted">{r.d}</dd></div>)}
      </dl>
    </div>
  </section>
  <section class="section t-paper" id="faq">
    <div class="wrap end__grid">
      <h2 class="d h-l">{C.asked[0]} <i>{C.asked[1]}</i></h2>
      <div class="fq__list">
        {faq.map((f) => (
          <details data-reveal>
            <summary><span>{f.q}</span><Icon name="plus" /></summary>
            <p class="body">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="section t-main">
    <div class="wrap end__cta">
      <h2 class="d h-l">{C.ready[0]} <i>{C.ready[1]}</i></h2>
      <div class="end__btns">
        <a class="btn" data-plans href="#top">{C.start} <Icon name="arrowUpRight" /></a>
        <a class="link" href={L('/contact/')}>{lang === 'es' ? 'Hablemos 20 minutos' : 'Talk for 20 minutes'} <Icon name="arrowRight" /></a>
      </div>
      <Next lang={lang} />
    </div>
  </section>
</Base>
