---
/** Lighthouse lab results: score rings (redesign, with the old value) + a metric table. Tabs when there are several runs. */
import type { LighthouseRun, Project } from '../data/content'
import { hostOf } from '../lib/site'
type Perf = NonNullable<Project['performance']>
interface Props { perf: Perf }
const { perf } = Astro.props

const sec = (ms: number) => `${(ms / 1000).toFixed(1)} s`
const size = (b: number) => (b >= 1e6 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.round(b / 1024)} KB`)
const ms = (v: number) => `${Math.round(v).toLocaleString('en-US')} ms`
const lead = (s: string) => s.charAt(0).toLowerCase() + s.slice(1)
const metrics: { key: keyof LighthouseRun; label: string; hint: string; fmt: (v: number) => string }[] = [
  { key: 'fcp', label: 'First Contentful Paint', hint: 'First text or image on screen', fmt: sec },
  { key: 'lcp', label: 'Largest Contentful Paint', hint: 'Main content visible', fmt: sec },
  { key: 'tbt', label: 'Total Blocking Time', hint: 'Time the page can’t respond to taps', fmt: ms },
  { key: 'cls', label: 'Cumulative Layout Shift', hint: 'How much the layout jumps', fmt: (v) => v.toFixed(3) },
  { key: 'si', label: 'Speed Index', hint: 'How fast the page fills in', fmt: sec },
  { key: 'bytes', label: 'Page weight', hint: 'Everything downloaded', fmt: size },
  { key: 'reqs', label: 'Requests', hint: 'Files fetched', fmt: (v) => String(v) },
  { key: 'js', label: 'JavaScript', hint: 'Script shipped to the browser', fmt: size },
]
const scores = [
  { key: 'perf', label: 'Performance' },
  { key: 'a11y', label: 'Accessibility' },
  { key: 'bp', label: 'Best practices' },
] as const
const change = (before: number, after: number) => {
  if (before === after) return '—'
  if (after === 0) return '−100%'
  const pct = Math.round(((after - before) / before) * 100)
  return pct < 0 ? `−${Math.abs(pct)}%` : `+${pct}%`
}
const intro = perf.before ? `the ${lead(perf.before.label)} against the ${lead(perf.after.label)}` : lead(perf.after.label)
---
<section class="cperf wrap sec--sm" aria-labelledby="cperf-title" data-tabs>
  <div class="cperf__top">
    <div>
      <h2 class="tag tag--accent" id="cperf-title">Performance</h2>
      <p class="h3 cperf__intro">Measured with Lighthouse, the engine behind Google PageSpeed Insights: {intro}.</p>
    </div>
    {perf.runs.length > 1 && (
      <div class="seg" role="group" aria-label="Page measured">
        {perf.runs.map((r, k) => <button type="button" data-tab={`run-${k}`} aria-pressed={k === 0 ? 'true' : 'false'}>{r.device}</button>)}
      </div>
    )}
  </div>
  {perf.runs.map((run, k) => (
    <div data-panel={`run-${k}`} hidden={k > 0}>
      <div class="cperf__rings">
        {scores.map((s) => {
          const v = run.after[s.key]
          return (
            <div class="ring" data-rv style={`--v:${v}`}>
              <div class="ring__dial">
                <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" pathLength="100" class="ring__t" /><circle cx="60" cy="60" r="52" pathLength="100" class="ring__v" /></svg>
                <span class="ring__n">{v}</span>
              </div>
              <span class="tag">{s.label}</span>
              {run.before && <span class="tag ring__was">was {run.before[s.key]}</span>}
            </div>
          )
        })}
      </div>
      <div class="cperf__wrap">
        <table class="cperf__table">
          <caption class="sr-only">{run.device}: {perf.before?.label ?? 'before'} versus {perf.after.label}</caption>
          <thead><tr><th scope="col">Metric</th>{run.before && <th scope="col">{perf.before?.label ?? 'Before'}</th>}<th scope="col">{perf.after.label}</th>{run.before && <th scope="col">Change</th>}</tr></thead>
          <tbody>
            {metrics.map((m) => (
              <tr>
                <th scope="row">{m.label}<span>{m.hint}</span></th>
                {run.before && <td class="cperf__old">{m.fmt(run.before[m.key])}</td>}
                <td class="cperf__new">{m.fmt(run.after[m.key])}</td>
                {run.before && <td class="cperf__d">{change(run.before[m.key], run.after[m.key])}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))}
  <p class="cperf__note">
    {perf.tool} · measured {perf.measured}{perf.before?.url && <> · before: {hostOf(perf.before.url)}</>}{perf.after.url && <> · after: {hostOf(perf.after.url)}</>}{perf.note && <> · {perf.note}</>}
  </p>
</section>
<style>
  .cperf__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px 40px; margin-bottom: clamp(28px, 3vw, 48px); }
  .cperf__intro { margin-top: 14px; max-width: 26ch; }
  .cperf__rings { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .ring { background: var(--bg); padding: clamp(24px, 3vw, 40px) 16px; display: grid; justify-items: center; gap: 10px; text-align: center; }
  .ring__dial { position: relative; width: min(100%, 150px); aspect-ratio: 1; }
  .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 7; }
  .ring__t { stroke: var(--line); }
  .ring__v { stroke: var(--red); stroke-dasharray: 100; stroke-dashoffset: calc(100 - var(--v)); transition: stroke-dashoffset 1.6s var(--ease) 0.2s; }
  html.js .ring:not(.in) .ring__v { stroke-dashoffset: 100; }
  .ring__n { position: absolute; inset: 0; display: grid; place-items: center; font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 700; letter-spacing: -0.06em; }
  .ring__was { color: var(--muted); }
  .cperf__wrap { overflow-x: auto; margin-top: 28px; }
  .cperf__table { width: 100%; border-collapse: collapse; min-width: 520px; }
  .cperf__table th, .cperf__table td { padding: 16px 12px 16px 0; border-bottom: 1px solid var(--line); text-align: right; font-variant-numeric: tabular-nums; }
  .cperf__table thead th { font-family: var(--mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); border-bottom-color: var(--fg); }
  .cperf__table th:first-child { text-align: left; }
  .cperf__table tbody th { font-weight: 600; }
  .cperf__table tbody th span { display: block; font-weight: 400; font-size: 0.82rem; color: var(--muted); margin-top: 2px; }
  .cperf__old { color: var(--muted); }
  .cperf__new { font-weight: 700; }
  .cperf__d { font-family: var(--mono); color: var(--accent); }
  .cperf__note { margin-top: 18px; font-family: var(--mono); font-size: 0.72rem; color: var(--muted); max-width: 120ch; line-height: 1.6; }
  @media (max-width: 640px) { .ring__n { font-size: 1.8rem; } .ring .tag { font-size: 0.6rem; } }
</style>
