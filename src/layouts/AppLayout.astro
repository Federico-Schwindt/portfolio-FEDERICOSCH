---
/** The client app's page: same fonts, tokens and theme as the site, its own chrome, never indexed. */
import '../styles/global.css'
import '../styles/app.css'
import '../styles/app-v2.css'
import '../styles/app-sections.css'
import '../styles/app-welcome.css'
interface Props { title: string; lang: 'en' | 'es' }
const { title, lang } = Astro.props
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="theme-color" content="#0b0b0b" />
    <script is:inline>(function(){try{var t=localStorage.getItem('theme');document.documentElement.dataset.theme=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch(e){}})()</script>
  </head>
  <body class="t-paper app-body"><slot /></body>
</html>
