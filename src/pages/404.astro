---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { url } from '../lib/site'
---
<Base title="Page not found | Federico Schwindt" noindex>
  <section class="t-main nf">
    <div class="wrap">
      <h1 class="d nf__n"><span class="n">4</span><span class="x">0</span><span class="n">4</span></h1>
      <p class="lead">This page does not exist. The work does.<br /><span lang="es" class="muted">Esta página no existe. Los trabajos, sí.</span></p>
      <a class="btn" href={url('/work/')}>See the work <Icon name="arrowUpRight" /></a>
    </div>
  </section>
</Base>
<style is:global>
  .nf { min-height: 100dvh; display: grid; align-items: end; padding: calc(var(--nav-h) + 3rem) 0 var(--section); }
  .nf .wrap { display: grid; gap: 2rem; justify-items: start; width: 100%; }
  .nf__n { font-size: clamp(8rem, 34vw, 38rem); line-height: 0.78; }
</style>
