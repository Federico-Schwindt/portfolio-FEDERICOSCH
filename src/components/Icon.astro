---
interface Props { name: 'arrow' | 'arrow-r' | 'plus' | 'close' | 'play'; size?: number; class?: string }
const { name, size = 24, class: cls } = Astro.props
const p = {
  arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
  'arrow-r': '<path d="M4 12h16M14 6l6 6-6 6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  play: '<path d="M8 5v14l11-7z" fill="currentColor"/>',
}[name]
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true" set:html={p} />
