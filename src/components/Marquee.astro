---
interface Props { items: string[]; class?: string; dur?: number }
const { items, class: cls, dur = 30 } = Astro.props
const row = [...items, ...items]
---
<div class:list={['marq', cls]} style={`--dur:${dur}s`} aria-hidden="true">
  {[0, 1].map(() => (
    <div class="marq__track">{row.map((t) => <><span>{t}</span><i /></>)}</div>
  ))}
</div>
<p class="sr-only">{items.join(' · ')}</p>
