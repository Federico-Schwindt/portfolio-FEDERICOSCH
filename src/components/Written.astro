---
/**
 * A heading drawn as real letter outlines, built at compile time from the site's own fonts.
 * Each glyph is one path, so the page can write it stroke by stroke (see src/scripts/written.ts).
 * Screen readers and search engines read the plain text; the drawing is hidden from them.
 */
import * as fontkit from 'fontkit'
interface Props { lines: { text: string; serif?: boolean }[]; id?: string; class?: string }
const { lines, id, class: cls = '' } = Astro.props
const archivo = (fontkit.openSync('node_modules/@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2') as any).getVariation({ wght: 900, wdth: 100 })
const serif = fontkit.openSync('node_modules/@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2') as any
const SIZE = 100, LEAD = 92
let maxW = 0
const rows = lines.map((ln, li) => {
  const f = ln.serif ? serif : archivo
  const s = (ln.serif ? SIZE * 1.04 : SIZE) / f.unitsPerEm
  const track = ln.serif ? 0 : -0.045 * SIZE
  const run = f.layout(ln.text)
  let x = 0
  const glyphs: { d: string }[] = []
  run.glyphs.forEach((g: any, i: number) => {
    const d = g.path.scale(s, -s).translate(x, 0).toSVG()
    if (d) glyphs.push({ d })
    x += run.positions[i].xAdvance * s + track
  })
  maxW = Math.max(maxW, x)
  return { glyphs, y: SIZE * 0.78 + li * LEAD, serif: !!ln.serif }
})
const H = SIZE * 0.78 + (lines.length - 1) * LEAD + SIZE * 0.3
const text = lines.map((l) => l.text).join(' ')
---
<h2 class={`written ${cls}`} id={id} data-written>
  <span class="sr-only">{text}</span>
  <svg viewBox={`0 0 ${maxW.toFixed(1)} ${H.toFixed(1)}`} style={`--w:${(maxW / SIZE).toFixed(3)}`} aria-hidden="true">
    {rows.map((r) => (
      <g class={r.serif ? 'written__serif' : 'written__sans'} transform={`translate(0 ${r.y.toFixed(1)})`}>
        {r.glyphs.map((g) => <path d={g.d} pathLength="1" />)}
      </g>
    ))}
  </svg>
</h2>
