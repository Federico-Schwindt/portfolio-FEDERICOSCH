---
import Icon from './Icon.astro'
import { data, t, langOf, type Lang } from '../i18n'
interface Props { variant: 'contact' | 'audit'; lang?: Lang }
const { variant, lang = langOf(Astro.url.pathname) } = Astro.props
const { site, offers } = data(lang)
const F = t(lang).form
const id = (n: string) => `${variant}-${n}`
---
<form class="form" data-lead={variant} data-email={site.email} novalidate>
  {variant === 'audit' ? (
    <Fragment>
      <div class="field">
        <label for={id('website')}>{F.website}</label>
        <input class="input" id={id('website')} name="website" inputmode="url" placeholder={F.websitePh} required />
      </div>
      <div class="field">
        <label for={id('email')}>{F.email}</label>
        <input class="input" id={id('email')} name="email" type="email" autocomplete="email" required />
      </div>
    </Fragment>
  ) : (
    <Fragment>
      <div class="field">
        <label for={id('name')}>{F.name}</label>
        <input class="input" id={id('name')} name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for={id('email')}>{F.email}</label>
        <input class="input" id={id('email')} name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for={id('company')}>{F.company}</label>
        <input class="input" id={id('company')} name="company" autocomplete="organization" />
      </div>
      <div class="field">
        <label for={id('website')}>{F.current}</label>
        <input class="input" id={id('website')} name="website" inputmode="url" placeholder={F.optional} />
      </div>
      <div class="field">
        <label for={id('service')}>{F.need}</label>
        <select class="input" id={id('service')} name="service">
          <option value="">{F.needUnsure}</option>
          {offers.map((o) => <option value={o.slug}>{o.name}</option>)}
          <option value="several">{F.several}</option>
        </select>
      </div>
      <div class="field">
        <label for={id('budget')}>{F.budget}</label>
        <input class="input" id={id('budget')} name="budget" placeholder={F.optional} />
      </div>
      <div class="field field--full">
        <label for={id('message')}>{F.message}</label>
        <textarea class="input" id={id('message')} name="message" required></textarea>
      </div>
    </Fragment>
  )}
  <div class="hp" aria-hidden="true"><label>{F.hp}<input name="company_url" tabindex="-1" autocomplete="off" /></label></div>
  <p class="form__error" data-error role="alert" hidden></p>
  <div class="field--full">
    <button class="btn" type="submit" data-label={variant === 'audit' ? F.sendAudit : F.send}>
      <span>{variant === 'audit' ? F.sendAudit : F.send}</span><Icon name="arrowUpRight" />
    </button>
  </div>
</form>
<script>import '../scripts/lead.ts'</script>
