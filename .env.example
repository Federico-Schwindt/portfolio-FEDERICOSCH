# Copy to .env.local. `neon deploy --env .env.local` fills the Neon-managed keys and reads the custom ones.

# ── written by `neon deploy` / `neon env pull` ──
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# NEON_REALTIME_URL=
# NEON_REALTIME_SECRET=
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_ENDPOINT_URL_S3= / AWS_REGION=

# ── custom, uploaded to the `api` function ──
ADMIN_EMAILS=leonel.sch2003@gmail.com
WEB_ORIGINS=https://federico-schwindt.github.io,http://localhost:4321,http://127.0.0.1:4321

# ── browser (Astro/Vite inlines VITE_* at build time; set the same three as GitHub repo variables) ──
# invocation URL of the `api` function: `neon functions get api`
VITE_API_URL=
VITE_NEON_AUTH_URL=$NEON_AUTH_BASE_URL
VITE_NEON_REALTIME_URL=$NEON_REALTIME_URL
