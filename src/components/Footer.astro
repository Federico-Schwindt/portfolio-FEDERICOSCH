---
import { nav, site, socials } from '../data/content'
import { url } from '../lib/site'
---
<footer class="ftr t-ink" data-theme="ink">
  <div class="wrap">
    <div class="ftr__top">
      <div>
        <p class="tag" style="color:var(--red);margin-bottom:16px">Have a project in mind?</p>
        <a class="ftr__mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div class="ftr__col">
        <h2>Pages</h2>
        <a href={url('/')}>Home</a>
        {nav.map((n) => <a href={url(n.href)}>{n.label}</a>)}
        <a href={url('/contact/')}>Contact</a>
      </div>
      <div class="ftr__col">
        <h2>Elsewhere</h2>
        {socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a>)}
      </div>
      <div class="ftr__col">
        <h2>Based in</h2>
        <p>{site.city}</p>
        <p><span data-clock>--:--</span> {site.utc}</p>
      </div>
    </div>
    <p class="ftr__word" aria-hidden="true">Schwindt<i></i></p>
    <div class="ftr__bot tag">
      <span>© {site.year} {site.name} · {site.agency}</span>
      <span>Built with Astro · No trackers</span>
    </div>
  </div>
</footer>
